model Role {
  id       String @id @default(cuid(2))
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name  String
  users UserRole[]
  perms RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  createdBy String?
  updatedBy String?

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("role")
}
