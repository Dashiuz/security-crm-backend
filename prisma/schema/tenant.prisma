model Tenant {
  id             String   @id @default(cuid(2))
  name           String
  slug           String   @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  updatedBy      String?
  logoUrl        String?
  primaryColor   String?  @default("#7C3AED")
  secondaryColor String?  @default("#5B21B6")
  sidebarColor   String?  @default("#1E1B4B")

  profile                        TenantProfile?
  subscription                   TenantSubscription?
  settings                       TenantSettings?

  employees   Employee[]
  users       User[]
  roles       Role[]
  departments Department[]
  positions   Position[]
  features    Feature[]

  minutas                        Minuta[]
  parkingResidentVehicleControls ParkingResidentVehicleControl[]
  visitorEntryControls           VisitorEntryControl[]
  correspondenceReceivedControls CorrespondenceReceivedControl[]
  clients                        Client[]
  residents                      Resident[]
  clientProperties               ClientProperties[]
  towers                         Tower[]
  floors                         Floor[]
  units                          Unit[]
  mediaAttachments               MediaAttachment[]
  fileImportLogs                 FileImportLog[]
  securityStudies                SecurityStudy[]
  pqrsTickets                    PqrsTicket[]
  pqrsMessages                   PqrsMessage[]
  notifications                  Notification[]
  userClientAccesses             UserClientAccess[]
  signatureRequests              SignatureRequest[]
  commercialSettings             CommercialSettings?
  tariffPeriodConfigs            TariffPeriodConfig[]
  securityServiceCatalogs        SecurityServiceCatalog[]
  positionSalaryMatrices         PositionSalaryMatrix[]
  valueAddedCatalogItems         ValueAddedCatalogItem[]
  tenantDocumentSkin             TenantDocumentSkin?
  documentTextSnippets           DocumentTextSnippet[]
  authorizedSigners              AuthorizedSigner[]
  serviceOrderDistributionRecipients ServiceOrderDistributionRecipient[]
  commercialProposals            CommercialProposal[]
  proposalServiceItems           ProposalServiceItem[]
  proposalValueAddedItems        ProposalValueAddedItem[]
  serviceOrders                  ServiceOrder[]
  serviceOrderPositions          ServiceOrderPosition[]
  serviceOrderEquipmentItems     ServiceOrderEquipmentItem[]
  serviceOrderDispatchLogs       ServiceOrderDispatchLog[]
  commercialFollowUps            CommercialFollowUp[]
  clientInsurancePolicies        ClientInsurancePolicy[]
  contractAddendums              ContractAddendum[]
  clientAnsCommitments           ClientAnsCommitment[]
  universalDocumentFormats       UniversalDocumentFormat[]
  formatVariables                FormatVariable[]

  // Payroll Relations (SPEC-ADM-028)
  payrollSettings                PayrollSettings?
  payrollHolidays                PayrollHoliday[]
  payrollConcepts                PayrollConcept[]
  payrollEntities                PayrollEntity[]
  payrollBanks                   PayrollBank[]
  payrollExitReasons             PayrollExitReason[]
  payrollCie10Codes              PayrollCie10[]
  payrollHiringRequirements      PayrollHiringRequirement[]
  payrollSvspLevels              PayrollSvspLevel[]
  payrollSecurityAcademies       PayrollSecurityAcademy[]
  payrollBranches                PayrollBranch[]
  payrollShiftModalities         PayrollShiftModality[]
  payrollModalityItems           PayrollModalityItem[]
  payrollDependencies            PayrollDependency[]
  payrollPeriods                 PayrollPeriod[]

  // Payroll Phase 2 Relations (SPEC-ADM-029)
  employeePayrollProfiles        EmployeePayrollProfile[]
  employeeFamilyMembers          EmployeeFamilyMember[]
  employeeRequirementChecks      EmployeeRequirementCheck[]
  employeeSvspCourses            EmployeeSvspCourse[]
  employeeInternalTrainings      EmployeeInternalTraining[]

  // Payroll Phase 3 Relations (SPEC-ADM-030)
  employeeDependencyAssignments  EmployeeDependencyAssignment[]
  payrollLeavesAndAbsences       PayrollLeaveAndAbsence[]
  payrollLoans                   PayrollLoan[]
  payrollLoanInstallments        PayrollLoanInstallment[]
  payrollPermanentConcepts       PayrollPermanentConcept[]
  payrollPeriodNovelties         PayrollPeriodNovelty[]
  payrollShiftSequences          PayrollShiftSequence[]
  payrollShiftRecords            PayrollShiftRecord[]

  // Payroll Phase 4 Relations (SPEC-ADM-031)
  employeeSalaryHistories        EmployeeSalaryHistory[]
  payrollAdvanceSettlements      PayrollAdvanceSettlement[]
  payrollAdvanceItems            PayrollAdvanceItem[]
  payrollPeriodSettlements       PayrollPeriodSettlement[]
  payrollSettlementLines         PayrollSettlementLine[]
  payrollBankDisbursementBatches PayrollBankDisbursementBatch[]

  // Payroll Phase 5 Relations (SPEC-ADM-032)
  payrollVacationSettlements     PayrollVacationSettlement[]
  payrollSocialBenefitBatches    PayrollSocialBenefitBatch[]
  payrollSocialBenefitItems      PayrollSocialBenefitItem[]
  payrollFinalSettlements        PayrollFinalContractSettlement[]

  @@map("tenant")
}

model TenantProfile {
  id                  String   @id @default(cuid(2))
  tenantId            String   @unique
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  legalName           String   @db.VarChar(150)
  taxId               String   @db.VarChar(50) // NIT/RUT
  contactEmail        String   @db.VarChar(100)
  contactPhone        String?  @db.VarChar(50)
  address             String?  @db.VarChar(200)
  city                String?  @db.VarChar(100)
  country             String?  @db.VarChar(100)
  legalRepresentative String?  @db.VarChar(150)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("tenant_profiles")
}

model TenantSubscription {
  id                 String             @id @default(cuid(2))
  tenantId           String             @unique
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planTier           PlanTier           @default(BASIC)
  status             SubscriptionStatus @default(TRIAL)

  maxClients         Int                @default(5)
  maxUsers           Int                @default(50)
  maxEmployees       Int                @default(50)

  subscriptionEndsAt DateTime?
  paymentGatewayId   String?            @db.VarChar(100)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("tenant_subscriptions")
}

model TenantSettings {
  id                    String         @id @default(cuid(2))
  tenantId              String         @unique
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Operativa
  timezone              String         @default("America/Bogota") @db.VarChar(50)
  currency              String         @default("COP") @db.VarChar(10)
  dateFormat            String         @default("DD/MM/YYYY") @db.VarChar(20)

  // Seguridad
  mfaRequired           Boolean        @default(false)
  sessionTimeoutMinutes Int            @default(60)
  passwordPolicy        PasswordPolicy @default(MEDIUM)

  // White-labeling avanzado
  faviconUrl            String?        @db.VarChar(255)
  loginBackgroundUrl    String?        @db.VarChar(255)
  supportEmail          String?        @db.VarChar(100)
  supportPhone          String?        @db.VarChar(50)

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@map("tenant_settings")
}
