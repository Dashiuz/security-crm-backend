model Employee {
  id       String @id @default(cuid(2))
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  clientHistory Json? @default("[]") @db.JsonB

  firstName       String
  secondName      String?
  lastName        String
  maternalSurname String?
  fullName        String
  documentType    String
  document        String
  birthdate       DateTime  @db.Date
  gender          String
  address         String    @default("")
  departmentId    String?
  positionId      String?
  email           String?
  phone           String?
  entryDate       DateTime  @db.Date
  isRetired       Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  createdBy       String?   @default("")
  updatedAt       DateTime  @updatedAt
  updatedBy       String?   @default("")
  retiredAt       DateTime? @db.Date
  deletedAt       DateTime?

  signatureUrl       String?                @db.Text
  signatureMethod    SignatureCreationMode?
  signatureUpdatedAt DateTime?

  departmentRef Department? @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  positionRef   Position?   @relation("EmployeePosition", fields: [positionId], references: [id], onDelete: SetNull)

  mediaAttachments MediaAttachment[]
  clientAccesses   UserClientAccess[]

  parkingControls        ParkingResidentVehicleControl[]
  visitorControls        VisitorEntryControl[]
  correspondenceControls CorrespondenceReceivedControl[]

  // SPEC-ADM-029: Expediente Laboral 360° y Cumplimiento SVSP
  payrollProfile         EmployeePayrollProfile?
  familyMembers          EmployeeFamilyMember[]
  requirementChecks      EmployeeRequirementCheck[]
  svspCourses            EmployeeSvspCourse[]
  internalTrainings      EmployeeInternalTraining[]

  // SPEC-ADM-030: Rotación de Puestos, Turnos, Novedades e Incapacidades
  dependencyAssignments  EmployeeDependencyAssignment[]
  leavesAndAbsences      PayrollLeaveAndAbsence[]
  payrollLoans           PayrollLoan[]
  permanentConcepts      PayrollPermanentConcept[]
  periodNovelties        PayrollPeriodNovelty[]
  shiftRecords           PayrollShiftRecord[]

  // SPEC-ADM-031: Liquidación de Nómina, Historial Salarial y Anticipos
  salaryHistories        EmployeeSalaryHistory[]
  advanceItems           PayrollAdvanceItem[]
  periodSettlements      PayrollPeriodSettlement[]
  settlementLines        PayrollSettlementLine[]

  // SPEC-ADM-032: Prestaciones Sociales, Vacaciones y Liquidación Definitiva
  vacationSettlements    PayrollVacationSettlement[]
  socialBenefitItems     PayrollSocialBenefitItem[]
  finalSettlements       PayrollFinalContractSettlement[]

  // SPEC-ADM-033: PILA, Nómina Electrónica DIAN y Certificados 220
  pilaRecordLines        PayrollPilaRecordLine[]
  electronicDocuments    PayrollElectronicDocument[]
  taxCertificates220     PayrollTaxCertificate220[]

  @@unique([tenantId, document])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([clientId])
  @@index([document])
  @@index([departmentId])
  @@index([positionId])
  @@map("employee")
}
