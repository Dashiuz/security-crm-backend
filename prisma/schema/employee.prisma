model Employee {
  id       String @id @default(cuid(2))
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  firstName       String
  secondName      String?
  lastName        String
  maternalSurname String?
  fullName        String
  documentType    String
  document        String
  birthdate       DateTime  @db.Date
  gender          String
  address         String    @default("")
  departmentId    String?
  positionId      String?
  email           String?
  phone           String?
  entryDate       DateTime  @db.Date
  isRetired       Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  createdBy       String?   @default("")
  updatedAt       DateTime  @updatedAt
  updatedBy       String?   @default("")
  retiredAt       DateTime? @db.Date
  deletedAt       DateTime?

  departmentRef Department? @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  positionRef   Position?   @relation("EmployeePosition", fields: [positionId], references: [id], onDelete: SetNull)

  coordinatedClients Client[] @relation("ClientCoordinator")
  commercialClients  Client[] @relation("ClientCommercialContact")
  mediaAttachments   MediaAttachment[]

  @@unique([tenantId, document])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([clientId])
  @@index([document])
  @@index([departmentId])
  @@index([positionId])
  @@map("employee")
}
