model AuditLog {
  id        String   @id @default(cuid(2))
  tenantId  String?
  entity    String
  entityId  String
  action    String
  oldValue  Json?
  newValue  Json?
  userId    String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_log")
}
