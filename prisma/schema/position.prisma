model Position {
  id       String  @id @default(cuid(2))
  tenantId String
  name     String
  level    Int?
  isActive Boolean @default(true)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employees Employee[] @relation("EmployeePosition")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("position")
}
